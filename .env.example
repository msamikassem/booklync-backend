# ─────────────────────────────────────────────
# Copy this to .env and fill in real values
# Never commit .env to GitHub
# ─────────────────────────────────────────────

# ── Database ──────────────────────────────────
# Local PostgreSQL:
DATABASE_URL=postgresql+psycopg2://postgres:yourpassword@localhost:5432/booking_platform
DB_USE_SSL=False

# Supabase (use the "Direct connection" string from Settings → Database):
# DATABASE_URL=postgresql+psycopg2://postgres:[password]@db.[project-ref].supabase.co:5432/postgres
# DB_USE_SSL=True

# ── Security ──────────────────────────────────
# Generate with: openssl rand -hex 32
SECRET_KEY=your_super_secret_key_here
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=30

# ── App ───────────────────────────────────────
APP_NAME=Booking Platform API
APP_ENV=development
DEBUG=True
API_BASE_URL=https://api.yourdomain.com
FRONTEND_URL=https://yourdomain.com

# ── Twilio (SMS) ──────────────────────────────
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_PHONE_NUMBER=+1234567890

# ── AI Providers ──────────────────────────────
ANTHROPIC_API_KEY=your_anthropic_api_key
OPENAI_API_KEY=your_openai_api_key

# ── Vapi (Voice) ──────────────────────────────
# Get from: dashboard.vapi.ai → Account → API Keys
VAPI_API_KEY=your_vapi_api_key
# Your public API URL — Vapi calls this for all webhooks
# Must be HTTPS and publicly accessible (use ngrok for local testing)
VAPI_SERVER_URL=https://api.yourdomain.com
# ElevenLabs voice ID — find more at elevenlabs.io/voice-library
# Popular options: rachel, adam, bella, elli, josh, arnold
ELEVENLABS_VOICE_ID=rachel

# ── Logging ───────────────────────────────────
LOG_LEVEL=INFO
LOG_FILE=logs/app.log
